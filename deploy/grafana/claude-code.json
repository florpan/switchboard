{
  "uid": "claude-code",
  "title": "Claude Code",
  "tags": [
    "claude-code",
    "switchboard"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds_loki",
        "label": "Loki",
        "query": "loki",
        "hide": 0
      },
      {
        "type": "datasource",
        "name": "ds_prom",
        "label": "Prometheus",
        "query": "prometheus",
        "hide": 2
      },
      {
        "type": "datasource",
        "name": "ds_tempo",
        "label": "Tempo",
        "query": "tempo",
        "hide": 0
      },
      {
        "type": "query",
        "name": "deployment",
        "label": "Deployment",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(claude_code_session_count_total, deployment)",
          "refId": "q"
        },
        "definition": "label_values(claude_code_session_count_total, deployment)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Usage",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Cost",
      "description": "Sum of cost_usd over every API request in the range",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap cost_usd [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Prompts",
      "description": "Turns started: typed prompts and channel messages (voice, Discord, email, jobs)",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"user_prompt\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Sessions",
      "description": "Sessions that made at least one API request",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "count(sum by (session_id) (count_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "API requests",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Output tokens",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap output_tokens [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Errors",
      "description": "API errors (tool failures are in the Activity row)",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_error\" [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cost over time",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "G",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (deployment) (sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap cost_usd [$__interval]))",
          "legendFormat": "{{deployment}}"
        }
      ],
      "maxDataPoints": 48,
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens over time",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "H",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap input_tokens [$__interval]))",
          "legendFormat": "input"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap output_tokens [$__interval]))",
          "legendFormat": "output"
        },
        {
          "refId": "J",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap cache_creation_tokens [$__interval]))",
          "legendFormat": "cache write"
        },
        {
          "refId": "K",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap cache_read_tokens [$__interval]))",
          "legendFormat": "cache read"
        }
      ],
      "maxDataPoints": 48,
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Cost by model",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "L",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (model) (sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap cost_usd [$__range]))",
          "legendFormat": "{{model}}",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #L",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "noValue": "None",
          "color": {
            "mode": "continuous-BlPu"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "gauge",
              "mode": "gradient",
              "valueDisplayMode": "text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "string"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Cost by source",
      "description": "repl_main_thread = the session itself; agent:* = subagents; prompt_suggestion, compact etc. = background requests",
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "M",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (query_source) (sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap cost_usd [$__range]))",
          "legendFormat": "{{query_source}}",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #M",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "noValue": "None",
          "color": {
            "mode": "continuous-BlPu"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "gauge",
              "mode": "gradient",
              "valueDisplayMode": "text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "string"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Time to first token (p50 / p95)",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "N",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "quantile_over_time(0.5, {service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap ttft_ms [$__interval]) by (deployment)",
          "legendFormat": "p50 {{deployment}}"
        },
        {
          "refId": "O",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"api_request\" | unwrap ttft_ms [$__interval]) by (deployment)",
          "legendFormat": "p95 {{deployment}}"
        }
      ],
      "maxDataPoints": 120,
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Activity",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Tool calls",
      "description": "MCP tools shown as server.tool",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "P",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "topk(20, sum by (tool) (count_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"tool_result\" | label_format tool=`{{ if eq .tool_name \"mcp_tool\" }}{{ regexReplaceAll \".*\\\"mcp_server_name\\\":\\\"([^\\\"]+)\\\",\\\"mcp_tool_name\\\":\\\"([^\\\"]+)\\\".*\" .tool_parameters \"${1}.${2}\" }}{{ else }}{{ .tool_name }}{{ end }}` [$__range])))",
          "legendFormat": "{{tool}}",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #P",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "None",
          "color": {
            "mode": "continuous-BlPu"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "gauge",
              "mode": "gradient",
              "valueDisplayMode": "text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "string"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Failed tool calls",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "Q",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (tool) (count_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"tool_result\" | success=\"false\" | label_format tool=`{{ if eq .tool_name \"mcp_tool\" }}{{ regexReplaceAll \".*\\\"mcp_server_name\\\":\\\"([^\\\"]+)\\\",\\\"mcp_tool_name\\\":\\\"([^\\\"]+)\\\".*\" .tool_parameters \"${1}.${2}\" }}{{ else }}{{ .tool_name }}{{ end }}` [$__range]))",
          "legendFormat": "{{tool}}",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #Q",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "None",
          "color": {
            "mode": "continuous-BlPu"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "gauge",
              "mode": "gradient",
              "valueDisplayMode": "text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "string"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Subagents (tokens)",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "R",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (agent_type) (sum_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"subagent_completed\" | unwrap total_tokens [$__range]))",
          "legendFormat": "{{agent_type}}",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #R",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "None",
          "color": {
            "mode": "continuous-BlPu"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "gauge",
              "mode": "gradient",
              "valueDisplayMode": "text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "string"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Tool calls over time",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "S",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum by (deployment) (count_over_time({service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"tool_result\" [$__interval]))",
          "legendFormat": "{{deployment}}"
        }
      ],
      "maxDataPoints": 48,
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Conversation",
      "description": "Prompts (▶) and replies (◀). Channel messages arrive as <channel ...> prompts.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "T",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=~\"user_prompt|assistant_response\" | query_source!=\"prompt_suggestion\" | line_format `{{ if eq .event_name \"user_prompt\" }}▶ [{{.deployment}}] {{.prompt}}{{ else }}◀ [{{.deployment}}] {{.response}}{{ end }}`",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      }
    },
    {
      "type": "logs",
      "title": "Tool calls",
      "description": "Every tool call with its input",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "U",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{service_name=\"claude-code\"} | deployment=~\"$deployment\" | event_name=\"tool_result\" | label_format tool=`{{ if eq .tool_name \"mcp_tool\" }}{{ regexReplaceAll \".*\\\"mcp_server_name\\\":\\\"([^\\\"]+)\\\",\\\"mcp_tool_name\\\":\\\"([^\\\"]+)\\\".*\" .tool_parameters \"${1}.${2}\" }}{{ else }}{{ .tool_name }}{{ end }}` | line_format `{{ if eq .success \"false\" }}✗{{ else }}✓{{ end }} [{{.deployment}}] {{.tool}} {{.duration_ms}}ms  {{.tool_input}}`",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      }
    },
    {
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Turns",
      "description": "One trace per turn. Open one to see model requests, tool calls and subagents nested.",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"claude-code\" && resource.deployment =~ \"$deployment\" && name = \"claude_code.interaction\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Turns with subagents",
      "description": "Spans made by a subagent carry agent_id; query_source_safe names its type",
      "gridPos": {
        "x": 12,
        "y": 46,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.deployment =~ \"$deployment\" && span.agent_id != nil }",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
